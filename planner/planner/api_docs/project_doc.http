### create an assigned project
# Replace these IDs with an existing project, project coordinator, and developer IDs.
POST http://127.0.0.1:8000/assignedprojects/
Content-Type: application/json

{
  "project": 2,
  "coordinator": 2,
  "developers": [4, 5],
  "project_duration": 6,
  "project_start_date": "2026-11-03",
  "project_tentative_end_date": "2027-01-02"
}

